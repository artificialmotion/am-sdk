<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>am_ros2_control</name>
  <version>0.2.0</version>
  <description>
    ros2_control SystemInterface plugin for Artificial Motion joints, built on the am-sdk C library.
    Pre-hardware release: runs against the am-sdk simulator (backend sim:&lt;unit&gt;).
  </description>
  <maintainer email="ayo@artificialmotion.com">Artificial Motion</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/artificialmotion/am-sdk</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
